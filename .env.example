# Server-only OpenAI configuration. Keep the key in .env.local; never use a
# NEXT_PUBLIC_ prefix. All capabilities are disabled by default.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_COMPANION_ENABLED=false
OPENAI_SPROUT_ENABLED=false
OPENAI_IMAGE_ANALYSIS_ENABLED=false
OPENAI_IMAGE_MODEL=
OPENAI_TRANSCRIPTION_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=
GETNOTE_API_KEY=
GETNOTE_CLIENT_ID=
GETNOTE_LINK_IMPORT_ENABLED=false
