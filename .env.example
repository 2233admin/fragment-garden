# Server-only OpenAI configuration for the stage 7B companion.
# Keep the key in .env.local; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_COMPANION_ENABLED=false
OPENAI_CONTENT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_EMBEDDING_MODEL=
GETNOTE_API_KEY=
GETNOTE_CLIENT_ID=
GETNOTE_LINK_IMPORT_ENABLED=false
