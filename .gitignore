# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/playwright-report/
/test-results/
/output/
/.playwright-cli/

# next.js
/.next/
/.next-playwright/
/.next-stage14-build/
/.next-release-build/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# env files
.env*
!.env.example

# local backups and user data
/backups/
/local-data/
/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
